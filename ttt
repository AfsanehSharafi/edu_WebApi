using Rooznabeh.Domain.Entities.WalletAgg;

namespace Rooznabeh.Infrastructure.Persistence;

public class DataBaseContext : DbContext
{
    public DataBaseContext(DbContextOptions<DataBaseContext> options) : base(options) { }

    public DbSet<User> Users => Set<User>();
    public DbSet<City> Cities => Set<City>();
    public DbSet<Category> Categories => Set<Category>();
    public DbSet<Ad> Ads => Set<Ad>();
    public DbSet<AdField> AdFields => Set<AdField>();
    public DbSet<Mark> Marks => Set<Mark>();
    public DbSet<Visit> Visits => Set<Visit>();
    public DbSet<Tarefe> Tarefes => Set<Tarefe>();
    public DbSet<Factor> Factors => Set<Factor>();
    public DbSet<Field> Fields => Set<Field>();
    public DbSet<FieldOption> FieldOptions => Set<FieldOption>();
    public DbSet<CategoryField> CategoryFields => Set<CategoryField>();
    public DbSet<Report> Reports => Set<Report>();
    public DbSet<Conversation> Conversations => Set<Conversation>();
    public DbSet<Message> Messages => Set<Message>();
    public DbSet<Wallet> Wallets => Set<Wallet>();
    public DbSet<WalletTransaction> WalletTransactions => Set<WalletTransaction>();

    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
    {
        optionsBuilder.ConfigureWarnings(warnings =>
            warnings.Ignore(Microsoft.EntityFrameworkCore.Diagnostics.RelationalEventId.PendingModelChangesWarning));
    }

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        base.OnModelCreating(modelBuilder);

        modelBuilder.Entity<Ad>(entity =>
        {
            entity.OwnsMany(a => a.Images, img =>
            {
                img.WithOwner().HasForeignKey("AdId");
                img.HasKey("AdId", "Url");
            });
            entity.HasOne(a => a.Category).WithMany().HasForeignKey(a => a.CategoryId);
            entity.HasOne(a => a.User).WithMany().HasForeignKey(a => a.UserId);

            entity.Property(a => a.IsNardeban).HasDefaultValue(false);
            entity.Property(a => a.NardebanActivatedAt).IsRequired(false);
            entity.HasIndex(a => new { a.CategoryId, a.CityId, a.IsNardeban, a.CreatedAt })
                  .HasDatabaseName("idx_ads_nardeban_sort");
        });

        modelBuilder.Entity<Tarefe>(entity =>
        {
            entity.Property(t => t.Type).HasConversion<int>();
        });

        modelBuilder.Entity<CategoryField>(entity =>
        {
            entity.ToTable("CategoryFields");
            entity.HasKey(cf => cf.Id);
            entity.HasOne(cf => cf.Category).WithMany().HasForeignKey(cf => cf.CategoryId).OnDelete(DeleteBehavior.Cascade);
            entity.HasOne(cf => cf.Field).WithMany().HasForeignKey(cf => cf.FieldId).OnDelete(DeleteBehavior.Cascade);
        });

        modelBuilder.Entity<FieldOption>(entity =>
        {
            entity.HasKey(o => o.Id);
            entity.HasOne(o => o.Field).WithMany(f => f.Options).HasForeignKey(o => o.FieldId).OnDelete(DeleteBehavior.Cascade);
        });

        modelBuilder.Entity<Factor>(entity =>
        {
            entity.HasOne(f => f.Ad).WithMany().HasForeignKey(f => f.AdId);
        });

        modelBuilder.Entity<Report>(entity =>
        {
            entity.HasOne<Ad>().WithMany().HasForeignKey(r => r.AdId);
            entity.HasOne<User>().WithMany().HasForeignKey(r => r.ReporterUserId);
        });

        modelBuilder.Entity<Conversation>(entity =>
        {
            entity.HasOne<Ad>().WithMany().HasForeignKey(c => c.AdId).IsRequired(false);
            entity.HasOne<User>().WithMany().HasForeignKey(c => c.User1Id).OnDelete(DeleteBehavior.Restrict);
            entity.HasOne<User>().WithMany().HasForeignKey(c => c.User2Id).OnDelete(DeleteBehavior.Restrict);
        });

        modelBuilder.Entity<Message>(entity =>
        {
            entity.HasOne(m => m.Conversation).WithMany(c => c.Messages).HasForeignKey(m => m.ConversationId);
            entity.HasOne<User>().WithMany().HasForeignKey(m => m.SenderId);
        });

        modelBuilder.Entity<User>(entity =>
        {
            entity.OwnsOne(u => u.Mobile, mobile =>
            {
                mobile.Property(m => m.Number).HasColumnName("Mobile");
            });
        });

        modelBuilder.Entity<Mark>(entity =>
        {
            entity.HasOne(m => m.Ad).WithMany().HasForeignKey(m => m.AdId);
        });

        modelBuilder.Entity<Visit>(entity =>
        {
            entity.HasOne(v => v.Ad).WithMany().HasForeignKey(v => v.AdId);
        });

        modelBuilder.Entity<Wallet>(entity =>
        {
            entity.HasKey(w => w.Id);
            entity.HasIndex(w => w.UserId).IsUnique();
            entity.HasMany(w => w.Transactions)
                  .WithOne()
                  .HasForeignKey(t => t.WalletId)
                  .OnDelete(DeleteBehavior.Cascade);
        });

        modelBuilder.Entity<WalletTransaction>(entity =>
        {
            entity.HasKey(t => t.Id);
            entity.Property(t => t.Amount).HasColumnType("decimal(18,2)");
        });
    }
}
