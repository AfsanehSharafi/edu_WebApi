using MediatR;
using Microsoft.Extensions.Logging;
using Rooznabeh.Application.Common.Interfaces;
using Rooznabeh.Domain.Entities.AdAggregate;
using Rooznabeh.Domain.Entities.BillingAgg;
using Rooznabeh.Domain.Events;
using Rooznabeh.Domain.Exceptions;
using Rooznabeh.Domain.Interfaces;

namespace Rooznabeh.Application.Ads.Commands.CreateAd;

public class CreateAdHandler : IRequestHandler<CreateAdCommand, CreateAdResponse>
{
    private readonly IAdRepository _adRepository;
    private readonly ICategoryRepository _categoryRepository;
    private readonly IFactorRepository _factorRepository;
    private readonly ITarefeRepository _tarefeRepository;
    private readonly IContentModerationService _moderationService;
    private readonly IUnitOfWork _unitOfWork;
    private readonly IFieldRepository _fieldRepository;
    private readonly IWalletRepository _walletRepository;
    private readonly IMediator _mediator;
    private readonly ILogger<CreateAdHandler> _logger;

    public CreateAdHandler(
        IAdRepository adRepository,
        ICategoryRepository categoryRepository,
        IFactorRepository factorRepository,
        ITarefeRepository tarefeRepository,
        IContentModerationService moderationService,
        IUnitOfWork unitOfWork,
        IFieldRepository fieldRepository,
        IWalletRepository walletRepository,
        IMediator mediator,
        ILogger<CreateAdHandler> logger)
    {
        _adRepository = adRepository;
        _categoryRepository = categoryRepository;
        _factorRepository = factorRepository;
        _tarefeRepository = tarefeRepository;
        _moderationService = moderationService;
        _unitOfWork = unitOfWork;
        _fieldRepository = fieldRepository;
        _walletRepository = walletRepository;
        _mediator = mediator;
        _logger = logger;
    }

    public async Task<CreateAdResponse> Handle(CreateAdCommand request, CancellationToken cancellationToken)
    {
        _logger.LogInformation("ایجاد آگهی توسط کاربر {UserId} در دسته {CategoryId}", request.UserId, request.CategoryId);

        await _unitOfWork.BeginTransactionAsync(cancellationToken);

        try
        {
            var category = await _categoryRepository.GetByIdAsync(request.CategoryId)
                ?? throw new CategoryNotFoundException(request.CategoryId);

            bool isPaid = category.IsPaid;

            if (isPaid && request.TarefeId is null)
                throw new PaymentRequiredException();

            var ad = new Ad(request.Title, request.Description, request.Price,
                request.CategoryId, request.CityId, request.UserId, isPaid, request.IsChatEnabled);

            var moderationResult = await _moderationService.ModerateAsync(ad);
            if (!moderationResult.IsApproved)
            {
                ad.Reject(moderationResult.RejectReason);
                await _adRepository.AddAsync(ad);
                await _unitOfWork.SaveChangesAsync(cancellationToken);
                await _unitOfWork.CommitTransactionAsync(cancellationToken);

                var rejectedEvent = ad.DomainEvents.OfType<AdStatusChangedDomainEvent>()
                    .FirstOrDefault(e => e.NewStatus == "Rejected");
                if (rejectedEvent is not null)
                {
                    ad.ClearDomainEvents();
                    await _mediator.Publish(rejectedEvent, cancellationToken);
                }

                _logger.LogWarning("آگهی {AdId} به دلیل {Reason} رد شد.", ad.Id, moderationResult.RejectReason);
                return new CreateAdResponse(ad.Id, isPaid, null, ad.Status.ToString(), null);
            }

            await _adRepository.AddAsync(ad);
            await _unitOfWork.SaveChangesAsync(cancellationToken);

            if (request.Fields is not null && request.Fields.Any())
            {
                foreach (var field in request.Fields)
                {
                    var adField = new AdField(ad.Id, field.FieldId, field.FieldValue);
                    await _fieldRepository.AddAdvertFieldAsync(adField);
                }
                await _unitOfWork.SaveChangesAsync(cancellationToken);
            }

            Factor? factor = null;
            string? paymentMethod = null;

            if (isPaid)
            {
                var tarefe = await _tarefeRepository.GetByIdAsync(request.TarefeId!.Value)
                    ?? throw new DomainException("تعرفه نامعتبر است.");

                bool useWallet = request.UseWallet;

                if (useWallet)
                {
                    // پرداخت با کیف پول
                    var debitSuccess = await _walletRepository.DebitAsync(
                        request.UserId,
                        tarefe.Price,
                        $"پرداخت آگهی {ad.Id} از کیف پول"
                    );

                    if (!debitSuccess)
                        throw new DomainException("موجودی کیف پول کافی نیست.");

                    factor = new Factor(ad.Id, tarefe);
                    factor.MarkAsPaid("wallet");
                    await _factorRepository.AddAsync(factor);

                    ad.SetExpiryDate(tarefe.DurationDays);
                    ad.SetPendingReview();
                    await _adRepository.UpdateAsync(ad);

                    paymentMethod = "Wallet";
                    _logger.LogInformation("آگهی {AdId} با کیف پول پرداخت شد.", ad.Id);
                }
                else
                {
                    // پرداخت آنلاین
                    factor = new Factor(ad.Id, tarefe);
                    await _factorRepository.AddAsync(factor);

                    ad.SetExpiryDate(tarefe.DurationDays);
                    await _adRepository.UpdateAsync(ad);

                    paymentMethod = "Gateway";
                    _logger.LogInformation("فاکتور {FactorId} برای آگهی {AdId} ایجاد شد.", factor.Id, ad.Id);
                }

                await _unitOfWork.SaveChangesAsync(cancellationToken);
            }

            await _unitOfWork.CommitTransactionAsync(cancellationToken);

            var createdEvent = ad.DomainEvents.OfType<AdCreatedDomainEvent>().FirstOrDefault();
            if (createdEvent is not null)
            {
                ad.ClearDomainEvents();
                await _mediator.Publish(createdEvent, cancellationToken);
            }

            _logger.LogInformation("آگهی {AdId} با موفقیت ثبت شد.", ad.Id);
            return new CreateAdResponse(ad.Id, isPaid, factor?.Id, ad.Status.ToString(), paymentMethod);
        }
        catch
        {
            await _unitOfWork.RollbackTransactionAsync(cancellationToken);
            throw;
        }
    }
}
